  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Configuration\n",
    "Defining file paths and model hyperparameters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============ FILE PATHS ============ \n",
    "POSITIVE_CSV = \"datasets/fusion_gene_positive_bp_information_with_class_for_modeling.txt\"\n",
    "NEGATIVE_CSV = \"datasets/fusion_gene_negative_bp_information_with_class_for_modeling.txt\"\n",
    "TEST_CSV = \"datasets/fusion_gene_positive_bp_information_with_class_for_testing.txt\"\n",
    "\n",
    "# Extra FASTA Sources\n",
    "EXTRA_POS_FASTA = \"datasets/blast_validated_chimeras.fasta,datasets/cosmic_high_confidence_sequences.fna,datasets/chimeras_43466.fa\"\n",
    "NEG_FASTA_CANONICAL = \"datasets/false_negative_candidates.fasta\"\n",
    "NEG_FASTA_SYNTHETIC = \"datasets/false_positive_candidates.fasta\"\n",
    "\n",
    "OUTPUT_DIR = \"./hyenadna_breakpoint_model\"\n",
    "MODEL_NAME = \"LongSafari/hyenadna-small-32k-seqlen-hf\" \n",
    "MAX_LENGTH = 20480  # 20kb Context\n",
    "\n",
    "# ============ DATA FILTERING ============\n",
    "MIN_SEQ_LENGTH = 100  # Drop sequences shorter than this (bp)\n",
    "MAX_N_RATIO = 0.5     # Drop sequences with >50% unknown bases ('N')\n",
    "\n",
    "# Hyperparameters\n",
    "NUM_EPOCHS = 5\n",
    "BATCH_SIZE = 8\n",
    "LEARNING_RATE = 1e-5\n",
    "VAL_SPLIT = 0.2"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Data Engineering\n",
    "\n",
    "**New Features in `DataPreparator`:**\n",
    "* **Configurable Filters**: Uses `min_seq_length` and `max_n_ratio` to clean data.\n",
    "* **`_trim_artifacts`**: Removes 3' Poly-A tails and 'N' blocks.\n",
    "* **`_apply_jitter`**: Randomly shifts fusion junctions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class DataPreparator:\n",
    "    COLUMNS = [\"Hgene\",\"Hchr\",\"Hbp\",\"Hstrand\",\"Tgene\",\"Tchr\",\"Tbp\",\"Tstrand\",\"5'-gene sequence (10Kb)\",\"3'-gene sequence (10Kb)\"]\n",
    "\n",
    "    def __init__(self, positive_csv_path: str, negative_csv_path: str, \n",
    "                 extra_fasta_paths: str = \"\", neg_fasta_canonical_path: str = \"\", \n",
    "                 neg_fasta_synthetic_path: str = \"\",\n",
    "                 min_seq_length: int = 100, max_n_ratio: float = 0.5):\n",
    "        \n",
    "        self.positive_csv_path = positive_csv_path\n",
    "        self.negative_csv_path = negative_csv_path\n",
    "        self.neg_fasta_canonical_path = neg_fasta_canonical_path\n",
    "        self.neg_fasta_synthetic_path = neg_fasta_synthetic_path\n",
    "        self.extra_fasta_paths = [p.strip() for p in extra_fasta_paths.split(',') if p.strip()]\n",
    "        \n",
    "        # Store config\n",
    "        self.min_seq_length = min_seq_length\n",
    "        self.max_n_ratio = max_n_ratio\n",
    "        \n",
    "        self.trans_table = str.maketrans(\"ATCGN\", \"TAGCN\")\n",
    "\n",
    "    def _trim_artifacts(self, sequence: str) -> str:\n",
    "        \"\"\"Removes Poly-A tails and N blocks to prevent 3' leakage.\"\"\"\n",
    "        if not isinstance(sequence, str): return \"\"\n",
    "        sequence = sequence.upper().rstrip('N')\n",
    "        if sequence.endswith('AAAAAAAAAA'):\n",
    "            for i in range(len(sequence)-1, -1, -1):\n",
    "                if sequence[i] != 'A':\n",
    "                    return sequence[:i+1]\n",
    "        return sequence\n",
    "\n",
    "    def _is_valid_sequence(self, seq: str) -> bool:\n",
    "        \"\"\"Sanity check: Filter based on length and unknown bases.\"\"\"\n",
    "        # 1. Length Check\n",
    "        if len(seq) < self.min_seq_length: return False  \n",
    "        \n",
    "        # 2. 'N' Content Check\n",
    "        if len(seq) > 0 and (seq.count('N') / len(seq) > self.max_n_ratio): return False \n",
    "        \n",
    "        return True\n",
    "\n",
    "    def _apply_jitter(self, seq_5p: str, seq_3p: str, target_len: int = 20480) -> str:\n",
    "        \"\"\"Operator 3: Shift-Invariant Junction (Random Jitter).\"\"\"\n",
    "        seq_5p = self._trim_artifacts(seq_5p)\n",
    "        seq_3p = self._trim_artifacts(seq_3p)\n",
    "        \n",
    "        shift = random.randint(-2500, 2500)\n",
    "        len_5p_take = 10240 + shift\n",
    "        len_3p_take = 10240 - shift\n",
    "        \n",
    "        def process(s, le, from_start=False):\n",
    "            if len(s) >= le:\n",
    "                return s[:le] if from_start else s[-le:]\n",
    "            else:\n",
    "                return (s + 'N'*(le-len(s))) if from_start else ('N'*(le-len(s)) + s)\n",
    "\n",
    "        part1 = process(seq_5p, len_5p_take, from_start=False)\n",
    "        part2 = process(seq_3p, len_3p_take, from_start=True)\n",
    "        return part1 + part2\n",
    "\n",
    "    def _get_reverse_complement(self, sequence: str) -> str:\n",
    "        return sequence.upper().translate(self.trans_table)[::-1]\n",
    "\n",
    "    def _load_fasta(self, path: str) -> List[str]:\n",
    "        if not os.path.exists(path): \n",
    "            print(f\"⚠️ WARNING: File not found: {path}. Skipping.\")\n",
    "            return []\n",
    "            \n",
    "        print(f\"   -> Loading extra sequences from: {path}\")\n",
    "        seqs, curr = [], []\n",
    "        with open(path, 'r') as f:\n",
    "            for line in f:\n",
    "                line = line.strip()\n",
    "                if line.startswith('>'):\n",
    "                    if curr: \n",
    "                        s = self._trim_artifacts(\"\".join(curr))\n",
    "                        if self._is_valid_sequence(s): seqs.append(s)\n",
    "                    curr = []\n",
    "                else:\n",
    "                    curr.append(line)\n",
    "            if curr: \n",
    "                s = self._trim_artifacts(\"\".join(curr))\n",
    "                if self._is_valid_sequence(s): seqs.append(s)\n",
    "        \n",
    "        print(f\"      Found {len(seqs)} valid sequences (>{self.min_seq_length}bp, <{self.max_n_ratio*100}% N).\")\n",
    "        return seqs\n",
    "\n",
    "    def load_and_prepare_data(self, augment: bool = True) -> pd.DataFrame:\n",
    "        # 1. Positives (Apply Jitter)\n",
    "        print(\"\\n--- Loading POSITIVE Data (Label 1) ---\")\n",
    "        if os.path.exists(self.positive_csv_path):\n",
    "            pos_df = pd.read_csv(self.positive_csv_path, header=None, names=self.COLUMNS, sep='\\t')\n",
    "            pos_df['sequence'] = pos_df.apply(\n",
    "                lambda row: self._apply_jitter(row[\"5'-gene sequence (10Kb)\"], row[\"3'-gene sequence (10Kb)\"]), axis=1\n",
    "            )\n",
    "            # Filter invalid after jitter\n",
    "            pos_df = pos_df[pos_df['sequence'].apply(self._is_valid_sequence)]\n",
    "            pos_df['label'] = 1\n",
    "            print(f\"   -> Main CSV loaded: {len(pos_df)} samples.\")\n",
    "        else:\n",
    "            print(f\"❌ ERROR: Main Positive CSV not found at {self.positive_csv_path}\")\n",
    "            pos_df = pd.DataFrame(columns=['sequence', 'label'])\n",
    "        \n",
    "        # Extra Positives\n",
    "        extra_seqs = []\n",
    "        for p in self.extra_fasta_paths: extra_seqs.extend(self._load_fasta(p))\n",
    "        \n",
    "        all_pos = pd.concat([pos_df[['sequence', 'label']], pd.DataFrame({'sequence':extra_seqs, 'label':1})])\n",
    "        print(f\">>> Total Positive Samples: {len(all_pos)}\")\n",
    "\n",
    "        # 2. Negatives (Apply Jitter)\n",
    "        print(\"\\n--- Loading NEGATIVE Data (Label 0) ---\")\n",
    "        if os.path.exists(self.negative_csv_path):\n",
    "            neg_df = pd.read_csv(self.negative_csv_path, header=None, names=self.COLUMNS, sep='\\t')\n",
    "            neg_df['sequence'] = neg_df.apply(\n",
    "                lambda row: self._apply_jitter(row[\"5'-gene sequence (10Kb)\"], row[\"3'-gene sequence (10Kb)\"]), axis=1\n",
    "            )\n",
    "            neg_df = neg_df[neg_df['sequence'].apply(self._is_valid_sequence)]\n",
    "            neg_df['label'] = 0\n",
    "            print(f\"   -> Main Negative CSV loaded: {len(neg_df)} samples.\")\n",
    "        else:\n",
    "            print(f\"⚠️ WARNING: Negative CSV not found at {self.negative_csv_path}\")\n",
    "            neg_df = pd.DataFrame(columns=['sequence', 'label'])\n",
    "        \n",
    "        neg_seqs = neg_df['sequence'].tolist() + \\\n",
    "                   self._load_fasta(self.neg_fasta_canonical_path) + \\\n",
    "                   self._load_fasta(self.neg_fasta_synthetic_path)\n",
    "        \n",
    "        final_neg = pd.DataFrame({'sequence': neg_seqs, 'label': 0})\n",
    "        print(f\">>> Total Initial Negative Samples: {len(final_neg)}\")\n",
    "\n",
    "        # 3. Augmentation (Reverse Complement)\n",
    "        if augment:\n",
    "            print(\"\\n--- Augmentation ---\")\n",
    "            print(\"Applying Reverse Complement Augmentation to Negatives...\")\n",
    "            aug = final_neg.copy()\n",
    "            aug['sequence'] = aug['sequence'].apply(self._get_reverse_complement)\n",
    "            final_neg = pd.concat([final_neg, aug])\n",
    "            print(f\">>> Total AUGMENTED Negative Samples: {len(final_neg)}\")\n",
    "        else:\n",
    "            print(\"Skipping augmentation.\")\n",
    "\n",
    "        # 4. Deduplication & Shuffling\n",
    "        combined = pd.concat([all_pos, final_neg], ignore_index=True)\n",
    "        \n",
    "        initial_count = len(combined)\n",
    "        combined.drop_duplicates(subset=['sequence'], keep='first', inplace=True)\n",
    "        final_count = len(combined)\n",
    "        if initial_count != final_count:\n",
    "            print(f\"🧹 Removed {initial_count - final_count} duplicate sequences.\")\n",
    "        else:\n",
    "            print(\"✅ No duplicates found.\")\n",
    "            \n",
    "        shuffled = combined.sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "        \n",
    "        print(f\"\\n=== FINAL DATASET SUMMARY ===")
    "        print(f"  Total samples: {len(shuffled)}\")\n",
    "        print(f"  Positive (1):  {(shuffled['label'] == 1).sum()}\")\n",
    "        print(f"  Negative (0):  {(shuffled['label'] == 0).sum()}\")\n",
    "        \n",
    "        return shuffled"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Model Architecture (Fixed KeyError)\n",
    "\n",
    "**FIX:** `DNABreakpointDataset` now manually generates the `attention_mask` if the tokenizer doesn't provide it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class DNABreakpointDataset(Dataset):\n",
    "    def __init__(self, sequences, labels, tokenizer, max_length):\n",
    "        self.sequences = sequences\n",
    "        self.labels = labels\n",
    "        self.tokenizer = tokenizer\n",
    "        self.max_length = max_length\n",
    "    \n",
    "    def __len__(self): return len(self.sequences)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        seq = self.sequences[idx]\n",
    "        if not isinstance(seq, str): seq = str(seq)\n",
    "        \n",
    "        enc = self.tokenizer(seq, truncation=True, max_length=self.max_length, padding='max_length', return_tensors='pt')\n",
    "        \n",
    "        input_ids = enc['input_ids'].squeeze(0)\n",
    "        \n",
    "        # --- FIX FOR KEYERROR: 'attention_mask' ---\n",
    "        if 'attention_mask' in enc:\n",
    "            attention_mask = enc['attention_mask'].squeeze(0)\n",
    "        else:\n",
    "            # Create mask manually: 1 for tokens, 0 for padding\n",
    "            # We assume pad_token_id is available, else we assume 0 or N\n",
    "            pad_id = self.tokenizer.pad_token_id if self.tokenizer.pad_token_id is not None else 0\n",
    "            attention_mask = (input_ids != pad_id).long()\n",
    "        \n",
    "        return {\n",
    "            'input_ids': input_ids,\n",
    "            'attention_mask': attention_mask,\n",
    "            'labels': torch.tensor(self.labels[idx], dtype=torch.long)\n",
    "        }\n",
    "\n",
    "class HyenaDNAClassifier(nn.Module):\n",
    "    def __init__(self, model_name, num_labels=2):\n",
    "        super().__init__()\n",
    "        self.hyena = AutoModel.from_pretrained(model_name, trust_remote_code=True)\n",
    "        self.head = nn.Linear(self.hyena.config.d_model, 1)\n",
    "        self.clf = nn.Linear(self.hyena.config.d_model, num_labels)\n",
    "        \n",
    "    def forward(self, input_ids, attention_mask=None, labels=None, output_attentions=False):\n",
    "        # Pass ONLY input_ids to Hyena backbone\n",
    "        out = self.hyena(input_ids).last_hidden_state\n",
    "        \n",
    "        # Attention Pooling\n",
    "        scores = self.head(out)\n",
    "        if attention_mask is not None:\n",
    "            scores = scores.masked_fill(attention_mask.unsqueeze(-1) == 0, float('-inf'))\n",
    "        \n",
    "        attn_probs = torch.softmax(scores, dim=1)\n",
    "        pooled = torch.sum(out * attn_probs, dim=1)\n",
    "        logits = self.clf(pooled)\n",
    "        \n",
    "        loss = None\n",
    "        if labels is not None:\n",
    "            loss = nn.CrossEntropyLoss()(logits, labels)\n",
    "            \n",
    "        ret = {'loss': loss, 'logits': logits}\n",
    "        if output_attentions:\n",
    "            ret['breakpoint_index'] = torch.argmax(attn_probs, dim=1).squeeze(-1)\n",
    "        return ret"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Training Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class HyenaDNATrainingPipeline:\n",
    "    def __init__(self, model_name, output_dir, max_length):\n",
    "        self.model_name = model_name\n",
    "        self.output_dir = output_dir\n",
    "        self.max_length = max_length\n",
    "        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)\n",
    "        self.model = None\n",
    "    \n",
    "    def train(self, train_df): \n",
    "        # Split\n",
    "        train_s, val_s, train_l, val_l = train_test_split(train_df['sequence'], train_df['label'], test_size=0.2)\n",
    "        train_ds = DNABreakpointDataset(train_s.tolist(), train_l.tolist(), self.tokenizer, self.max_length)\n",
    "        val_ds = DNABreakpointDataset(val_s.tolist(), val_l.tolist(), self.tokenizer, self.max_length)\n",
    "\n",
    "        self.model = HyenaDNAClassifier(self.model_name).to(self.device)\n",
    "        \n",
    "        args = TrainingArguments(\n",
    "            output_dir=self.output_dir, num_train_epochs=NUM_EPOCHS, per_device_train_batch_size=BATCH_SIZE,\n",
    "            learning_rate=LEARNING_RATE, save_strategy=\"no\", \n",
    "            logging_steps=500 # CHANGED: Log loss every 500 steps instead of 50\n",
    "        )\n",
    "        \n",
    "        trainer = Trainer(\n",
    "            model=self.model, args=args, train_dataset=train_ds, eval_dataset=val_ds,\n",
    "            compute_metrics=lambda p: {'acc': accuracy_score(p.label_ids, np.argmax(p.predictions, axis=1))}\n",
    "        )\n",
    "        trainer.train()\n",
    "        \n",
    "        # Manual Save\n",
    "        os.makedirs(f\"{self.output_dir}/final\", exist_ok=True)\n",
    "        torch.save(self.model.state_dict(), f\"{self.output_dir}/final/model.bin\")\n",
    "        self.tokenizer.save_pretrained(f\"{self.output_dir}/final\")\n",
    "        \n",
    "    def predict(self, csv_path, output_path, batch_size=8):\n",
    "        # Simplified loading for test set (assumes 5'+3')\n",
    "        df = pd.read_csv(csv_path, header=None, names=DataPreparator.COLUMNS, sep='\\t')\n",
    "        df['sequence'] = df[\"5'-gene sequence (10Kb)\"] + df[\"3'-gene sequence (10Kb)\"] \n",
    "        \n",
    "        labels = df['label'].tolist() if 'label' in df else [0]*len(df)\n",
    "        \n",
    "        ds = DNABreakpointDataset(df['sequence'].tolist(), labels, self.tokenizer, self.max_length)\n",
    "        dl = DataLoader(ds, batch_size=batch_size)\n",
    "        \n",
    "        self.model.eval()\n",
    "        preds, probs, locs = [], [], []\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for b in tqdm(dl):\n",
    "                # Handle mask here too\n",
    "                b_input = b['input_ids'].to(self.device)\n",
    "                b_mask = b['attention_mask'].to(self.device)\n",
    "                \n",
    "                out = self.model(b_input, attention_mask=b_mask, output_attentions=True)\n",
    "                prob = torch.softmax(out['logits'], dim=-1)\n",
    "                probs.extend(prob[:, 1].cpu().numpy())\n",
    "                preds.extend(torch.argmax(prob, dim=-1).cpu().numpy())\n",
    "                locs.extend(out['breakpoint_index'].cpu().numpy())\n",
    "        \n",
    "        df['breakpoint_probability'] = probs\n",
    "        df['predicted_label'] = preds\n",
    "        df['predicted_breakpoint_loc'] = locs\n",
    "        return df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Execution: Load & Train"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pass configuration explicitly to DataPreparator\n",
    "prep = DataPreparator(POSITIVE_CSV, NEGATIVE_CSV, \n",
    "                      extra_fasta_paths=EXTRA_POS_FASTA,\n",
    "                      neg_fasta_canonical_path=NEG_FASTA_CANONICAL,\n",
    "                      neg_fasta_synthetic_path=NEG_FASTA_SYNTHETIC,\n",
    "                      min_seq_length=MIN_SEQ_LENGTH,  # Filter <100bp\n",
    "                      max_n_ratio=MAX_N_RATIO)        # Filter >50% Ns\n",
    "\n",
    "train_df = prep.load_and_prepare_data(augment=True)\n",
    "\n",
    "pipeline = HyenaDNATrainingPipeline(MODEL_NAME, OUTPUT_DIR, MAX_LENGTH)\n",
    "pipeline.train(train_df)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Validated Prediction (Mixed Test Set)\n",
    "\n",
    "This section implements the **Dual-Prediction Logic** to ensure valid ROC AUC calculation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Predict on POSITIVES (Label 1)\n",
    "print(\"Predicting on Positives (Label 1)...\")\n",
    "pos_df = pipeline.predict(TEST_CSV, output_path=\"pos_preds.csv\", batch_size=BATCH_SIZE)\n",
    "pos_df['label'] = 1  \n",
    "\n",
    "# 2. Predict on NEGATIVES (Label 0)\n",
    "print(\"Predicting on Negatives (Label 0)...\")\n",
    "neg_df = pipeline.predict(NEGATIVE_CSV, output_path=\"neg_preds.csv\", batch_size=BATCH_SIZE)\n",
    "# Balance the test set for visualization\n",
    "if len(neg_df) > len(pos_df): neg_df = neg_df.sample(n=len(pos_df), random_state=42)\n",
    "neg_df['label'] = 0 \n",
    "\n",
    "# 3. Combine\n",
    "predictions_df = pd.concat([pos_df, neg_df], ignore_index=True)\n",
    "print(f\"Final Test Set: {len(predictions_df)} samples\")\n",
    "\n",
    "# 4. Visualize\n",
    "sns.set_style(\"whitegrid\")\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "# A: Confidence\n",
    "sns.histplot(data=predictions_df, x='breakpoint_probability', hue='label', bins=30, kde=True, ax=axes[0], palette=['red', 'green'])\n",
    "axes[0].set_title(\"Confidence Distribution\")\n",
    "\n",
    "# B: ROC (Valid Calculation)\n",
    "final_auc = roc_auc_score(predictions_df['label'], predictions_df['breakpoint_probability'])\n",
    "fpr, tpr, _ = roc_curve(predictions_df['label'], predictions_df['breakpoint_probability'])\n",
    "axes[1].plot(fpr, tpr, color='blue', lw=2, label=f\"AUC = {final_auc:.4f}\")\n",
    "axes[1].plot([0, 1], [0, 1], 'k--')\n",
    "axes[1].set_title(\"ROC Curve\")\n",
    "axes[1].legend()\n",
    "\n",
    "# C: Localization (Positives Only)\n",
    "true_pos = predictions_df[predictions_df['label'] == 1]\n",
    "sns.histplot(data=true_pos, x='predicted_breakpoint_loc', bins=50, ax=axes[2], color='purple')\n",
    "axes[2].set_title(\"Predicted Breakpoints (Positives)\")\n",
    "axes[2].set_xlabel(\"Genomic Index\")\n",
    "axes[2].axvline(10240, color='orange', linestyle='--', label='Original Center')\n",
    "axes[2].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
